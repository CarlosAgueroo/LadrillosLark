<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<section class="hero"><div><p class="eyebrow">CATÁLOGO INTERNO</p><h1>Productos y existencias.</h1><p>Ladrillos, cemento y herramientas para construir.<br>Consulta existencias y registra ventas en un solo lugar.</p><a href="#catalogo" class="btn btn-primary btn-lg">Explorar materiales →</a></div><div class="hero-art"><img src="<%=base%>/img/ladrillo.svg" alt="Ilustración de ladrillo"><span>RESISTENCIA DESDE LA BASE</span></div></section>
<section id="catalogo"><div class="section-title"><div><p class="eyebrow">CONSULTA DE PRODUCTOS</p><h2>Nuestros materiales</h2></div><span class="muted">Stock consultado al cargar · Actualiza cada 30 s</span></div>
<form class="search-bar" method="get" action="<%=base%>/app/catalogo"><label class="grow">Buscar<input class="form-control" name="q" placeholder="Nombre o código del producto" value="<%=html(request.getParameter("q"))%>"></label><label>Categoría<select class="form-select" name="categoria"><option value="">Todas las categorías</option><% for(Fila c:(List<Fila>)request.getAttribute("categorias")){ %><option value="<%=c.entero("id")%>" <%=c.texto("id").equals(request.getParameter("categoria"))?"selected":""%>><%=html(c.texto("nombre"))%></option><% } %></select></label><button class="btn btn-dark">Buscar</button></form>
<div class="product-grid" data-refresh="30"><% List<Fila> prods=(List<Fila>)request.getAttribute("productos"); if(prods.isEmpty()){ %><p>No hay productos para esta búsqueda.</p><% } for(Fila p:prods){ %><article class="product-card"><a class="product-img" href="<%=base%>/app/producto?id=<%=p.entero("id")%>"><img src="<%=base%>/img/<%=html(p.texto("imagen"))%>" alt="<%=html(p.texto("nombre"))%>"></a><div class="product-body"><p class="eyebrow"><%=html(p.texto("categoria"))%> · <%=html(p.texto("codigo"))%></p><h3><a href="<%=base%>/app/producto?id=<%=p.entero("id")%>"><%=html(p.texto("nombre"))%></a></h3><p class="stock <%=p.entero("stock")<=p.entero("stock_minimo")?"low":""%>"><%=p.entero("stock")==0?"Agotado":p.entero("stock")+" disponibles"%><%=p.entero("stock")<=p.entero("stock_minimo")?" · Stock bajo":""%></p><div class="price-row"><strong>S/ <%=p.decimal("precio")%></strong><a class="btn btn-outline-dark" href="<%=base%>/app/producto?id=<%=p.entero("id")%>">Ver producto →</a></div></div></article><% } %></div></section>
<%@ include file="pie.jspf" %>
