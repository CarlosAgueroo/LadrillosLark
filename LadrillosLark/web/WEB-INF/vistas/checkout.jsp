<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<h1>Registrar venta</h1><% List<LineaCarrito> lineas=(List<LineaCarrito>)request.getAttribute("lineas");BigDecimal sub=BigDecimal.ZERO;for(LineaCarrito l:lineas)sub=sub.add(l.subtotal()); %><form method="post" action="<%=base%>/app/comprar" class="checkout-grid"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="token" value="<%=html(session.getAttribute("compraToken"))%>"><section class="panel"><h2>Datos de entrega</h2><label>Descuento (%) · máximo 10<input class="form-control" id="descuento" name="descuento" type="number" min="0" max="10" step="0.01" value="0" required></label><label>Modalidad<select class="form-select" name="envio" id="envio"><option value="0">Recojo en tienda · Gratis</option><option value="1">Delivery · S/ 25.00</option></select></label><label>Dirección<input class="form-control" name="direccion" maxlength="250" value=""></label><label>Distrito<input class="form-control" name="distrito" maxlength="100"></label><label>Referencia<input class="form-control" name="referencia" maxlength="250"></label><label>Teléfono<input class="form-control" name="telefono" required maxlength="20" value=""></label><h2>Pago</h2><label>Método<select name="metodo" class="form-select"><option value="TARJETA">Tarjeta (simulada)</option><option value="YAPE">Yape (simulado)</option><option value="PLIN">Plin (simulado)</option><option value="CONTRA_ENTREGA">Pago contra entrega</option></select></label><div class="alert alert-warning">Demostración: no ingreses datos de tarjeta ni realices transferencias. El Administrador o Cajero confirma o rechaza el pago simulado desde Pedidos.</div></section><aside class="panel"><h2>Resumen del pedido</h2><% for(LineaCarrito l:lineas){ %><p><%=l.cantidad%> × <%=html(l.nombre)%><br><strong>S/ <%=l.subtotal()%></strong></p><% } %><hr><p>Subtotal: S/ <%=sub%></p><p>Delivery: S/ <span id="deliveryCosto">0.00</span></p><p class="big-price">S/ <span id="total" data-subtotal="<%=sub%>"><%=sub%></span></p><button class="btn btn-primary w-100" <%=lineas.isEmpty()?"disabled":""%>>Registrar venta</button><p class="muted">Verificaremos nuevamente las existencias. Entrega estimada: 2 días para delivery.</p></aside></form>
<%@ include file="pie.jspf" %>
