<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<% Fila p=(Fila)request.getAttribute("producto"); %><a href="<%=base%>/app/catalogo">← Volver al catálogo</a><section class="detail-grid panel"><div class="detail-art"><img src="<%=base%>/img/<%=html(p.texto("imagen"))%>" alt="<%=html(p.texto("nombre"))%>"></div><div><p class="eyebrow"><%=html(p.texto("codigo"))%></p><h1><%=html(p.texto("nombre"))%></h1><p><%=html(p.texto("descripcion"))%></p><p class="big-price">S/ <%=p.decimal("precio")%></p><p><%=p.entero("stock")%> unidades disponibles</p><% if(user!=null&&user.es(1,2)&&p.entero("stock")>0){ %><form method="post" action="<%=base%>/app/carrito"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="producto" value="<%=p.entero("id")%>"><input type="hidden" name="accion" value="sumar"><label>Cantidad<input class="form-control" type="number" name="cantidad" min="1" max="<%=p.entero("stock")%>" value="1" required></label><button class="btn btn-primary">Agregar a la venta</button></form><% } %></div></section>
<%@ include file="pie.jspf" %>
