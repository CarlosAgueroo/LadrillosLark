<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<h1>Reportes</h1><form method="get" action="<%=base%>/app/reportes" class="panel search-bar"><label>Reporte<select class="form-select" name="tipo"><% for(String tipo:new String[]{"ventas","inventario","stock","pedidos","delivery","mas_vendidos","menos_vendidos","stock_bajo"}){ %><option value="<%=tipo%>" <%=tipo.equals(request.getAttribute("tipo"))?"selected":""%>><%=tipo.replace('_',' ')%></option><% } %></select></label><label>Desde<input class="form-control" name="desde" type="date" value="<%=html(request.getAttribute("desde"))%>"></label><label>Hasta<input class="form-control" name="hasta" type="date" value="<%=html(request.getAttribute("hasta"))%>"></label><button class="btn btn-dark">Consultar</button><button name="formato" value="csv" class="btn btn-outline-dark">Exportar CSV</button><button type="button" id="imprimir" class="btn btn-outline-dark">Imprimir / PDF</button></form><p class="muted">Stock muestra la situación actual. Los otros reportes usan el rango de fechas. Ranking: unidades con pago confirmado; incluye productos con cero ventas.</p><section class="panel"><%@ include file="tabla.jspf" %></section>
<%@ include file="pie.jspf" %>
