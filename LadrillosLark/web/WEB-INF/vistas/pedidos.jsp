<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<h1>Gestión de pedidos y delivery</h1><p class="muted">Pagos simulados. Para entregar un pedido primero debe constar como pagado.</p><% List<Fila> pedidos=(List<Fila>)request.getAttribute("pedidos");if(pedidos.isEmpty()){ %><section class="panel">Todavía no hay pedidos.</section><% }for(Fila p:pedidos){ %><article class="panel"><div class="section-title"><div><p class="eyebrow"><%=html(p.texto("fecha"))%></p><h2><%=html(p.texto("codigo"))%> · <%=html(p.texto("operador"))%></h2></div><strong class="big-price">S/ <%=p.decimal("total")%></strong></div><div class="status-row"><span class="badge text-bg-dark">Pedido: <%=html(p.texto("estado"))%></span><span class="badge text-bg-secondary">Pago: <%=html(p.texto("pago_estado"))%></span><span class="badge text-bg-light">Delivery: <%=html(p.texto("delivery_estado"))%></span></div><p><%=html(p.texto("metodo"))%> · <%=html(p.texto("direccion"))%> <%=html(p.texto("distrito"))%><br><%=html(p.texto("referencia"))%> · <%=html(p.texto("telefono"))%></p><% if(!p.texto("fecha_estimada").isEmpty()){ %><p>Fecha estimada: <%=html(p.texto("fecha_estimada"))%> · Fecha de entrega: <%=html(p.texto("fecha_entrega"))%></p><% } %><a href="<%=base%>/app/detalle?id=<%=p.entero("id")%>">Ver productos</a>
<% if(!Arrays.asList("CANCELADO","ENTREGADO").contains(p.texto("estado"))){ %><form method="post" action="<%=base%>/app/estado" class="actions"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="id" value="<%=p.entero("id")%>"><label>Acción<select name="accion" class="form-select"><% if(user.es(1,2)&&p.texto("pago_estado").equals("PENDIENTE")){ %><option value="PAGAR">Confirmar pago simulado / cobro</option><option value="RECHAZAR">Rechazar pago y cancelar</option><% } %><% if(user.es(1,3)&&(p.texto("estado").equals("PAGADO")||(p.texto("estado").equals("PENDIENTE")&&p.texto("metodo").equals("CONTRA_ENTREGA")))){ %><option>PREPARANDO</option><% } %><% if(user.es(1,3)&&p.texto("estado").equals("PREPARANDO")&&!p.texto("delivery_estado").equals("RECOJO")){ %><option>EN_CAMINO</option><% } %><% if(user.es(1,3)&&p.texto("pago_estado").equals("PAGADO")&&(p.texto("estado").equals("EN_CAMINO")||(p.texto("estado").equals("PREPARANDO")&&p.texto("delivery_estado").equals("RECOJO")))){ %><option>ENTREGADO</option><% } %><% if(user.es(1,2)){ %><option value="CANCELAR">Cancelar / reembolsar simulado</option><% } %></select></label><button class="btn btn-outline-dark" data-confirm="¿Confirmas esta operación sobre el pedido?">Aplicar acción</button></form><% } %></article><% } %>
<%@ include file="pie.jspf" %>
