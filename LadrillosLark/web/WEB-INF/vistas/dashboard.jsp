<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<div class="section-title"><div><p class="eyebrow">PANEL DE CONTROL</p><h1>Así va Lark</h1></div><a class="btn btn-dark" href="<%=base%>/app/reportes">Ver reportes →</a></div><p class="muted">Ingresos: ventas con pago confirmado, excluye cancelaciones. Semana desde el lunes; mes calendario.</p><div class="metrics" data-refresh="30"><% Fila metricas=(Fila)request.getAttribute("metricas");for(String key:metricas.keySet()){ %><article class="metric"><p><%=html(key.replace('_',' '))%></p><strong><%=key.startsWith("ventas_")||key.equals("ingresos")?"S/ ":""%><%=html(metricas.get(key))%></strong></article><% } %></div><div class="dashboard-grid"><section class="panel"><h2>Atención al stock</h2><% List<Fila> bajos=(List<Fila>)request.getAttribute("bajo");if(bajos.isEmpty()){ %><p>No hay alertas de stock.</p><% }for(Fila b:bajos){ %><div class="list-row"><span><%=html(b.texto("nombre"))%></span><strong class="low"><%=b.entero("stock")%> / mín. <%=b.entero("stock_minimo")%></strong></div><% } %></section><section class="panel"><h2>Más vendidos</h2><% List<Fila> top=(List<Fila>)request.getAttribute("top");for(int i=0;i<Math.min(5,top.size());i++){Fila t=top.get(i); %><div class="list-row"><span><%=i+1%>. <%=html(t.texto("nombre"))%></span><strong><%=html(t.texto("unidades"))%> uds.</strong></div><% } %></section></div>
<%@ include file="pie.jspf" %>
