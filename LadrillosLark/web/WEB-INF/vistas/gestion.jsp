<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<% Entidad ent=(Entidad)request.getAttribute("entidad");Fila edit=(Fila)request.getAttribute("edicion"); %><div class="section-title"><h1><%=html(ent.titulo)%></h1><a class="btn btn-outline-dark" href="<%=base%>/app/gestion?entidad=<%=ent.nombre%>">Nuevo registro</a></div><details class="panel" <%=edit.isEmpty()?"":"open"%>><summary><%=edit.isEmpty()?"Registrar ":"Editar #"+edit.texto("id")+" · "%><%=html(ent.titulo)%></summary><form class="form-grid" method="post" action="<%=base%>/app/guardar"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="entidad" value="<%=ent.nombre%>"><input type="hidden" name="id" value="<%=html(edit.texto("id"))%>"><% for(String f:ent.campos){String val=edit.texto(f); %><label><%=html(f.replace('_',' '))%>
<% if(f.equals("categoria_id")){ %><select class="form-select" name="<%=f%>" required><% for(Fila cat:(List<Fila>)request.getAttribute("categorias")){ %><option value="<%=cat.entero("id")%>" <%=cat.texto("id").equals(val)?"selected":""%>><%=html(cat.texto("nombre"))%></option><% } %></select>
<% }else if(f.equals("rol_id")){ %><select class="form-select" name="<%=f%>"><% String[] roles={"Administrador","Cajero","Almacenero"};for(int a=0;a<3;a++){ %><option value="<%=a+1%>" <%=String.valueOf(a+1).equals(val)?"selected":""%>><%=roles[a]%></option><% } %></select>
<% }else if(f.equals("activo")){ %><select class="form-select" name="activo"><option value="1" <%=val.matches("0|false")?"":"selected"%>>Activo</option><option value="0" <%=val.matches("0|false")?"selected":""%>>Inactivo</option></select>
<% }else if(f.equals("imagen")){ %><select class="form-select" name="imagen"><% for(String img:new String[]{"ladrillo.svg","cemento.svg","arena.svg","herramienta.svg"}){ %><option <%=img.equals(val)?"selected":""%>><%=img%></option><% } %></select>
<% }else{ %><input class="form-control" name="<%=f%>" type="<%=f.equals("correo")?"email":f.equals("precio")||f.equals("stock_minimo")?"number":"text"%>" value="<%=html(val)%>" required <%=f.equals("precio")?"step='0.01' min='0.01'":f.equals("stock_minimo")?"min='0'":""%> maxlength="<%=f.equals("descripcion")?1000:f.equals("direccion")?250:f.equals("dni")?8:f.equals("ruc")?11:f.equals("telefono")?20:f.equals("correo")?120:f.equals("codigo")?30:f.equals("usuario")?50:80%>"><% } %></label><% } %>
<% if(ent.nombre.equals("usuario")){ %><label>Contraseña <%=edit.isEmpty()?"":"(vacía: conservar)"%><input class="form-control" type="password" name="clave" minlength="8" maxlength="128" <%=edit.isEmpty()?"required":""%> autocomplete="new-password"></label><% } %><button class="btn btn-primary">Guardar</button></form><% if(ent.nombre.equals("producto")){ %><p class="muted">Los nuevos productos empiezan con stock 0. Registra su entrada desde Inventario.</p><% } %></details>
<section class="panel"><h2>Registros</h2><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Acción</th><th>ID</th><% for(String f:ent.campos){ %><th><%=html(f)%></th><% } %></tr></thead><tbody><% for(Fila row:(List<Fila>)request.getAttribute("filas")){ %><tr><td><a class="btn btn-sm btn-outline-dark" href="<%=base%>/app/gestion?entidad=<%=ent.nombre%>&amp;id=<%=row.entero("id")%>">Editar</a></td><td><%=row.entero("id")%></td><% for(String f:ent.campos){ %><td><%=html(row.texto(f))%></td><% } %></tr><% } %></tbody></table></div></section>
<% if(ent.nombre.equals("proveedor")){ %><section class="panel"><h2>Productos suministrados</h2><form method="post" action="<%=base%>/app/asociar" class="form-grid"><input type="hidden" name="csrf" value="<%=csrf%>"><label>Producto<select class="form-select" name="producto"><% for(Fila pr:(List<Fila>)request.getAttribute("productos")){ %><option value="<%=pr.entero("id")%>"><%=html(pr.texto("nombre"))%></option><% } %></select></label><label>Proveedor<select class="form-select" name="proveedor"><% for(Fila pr:(List<Fila>)request.getAttribute("filas")){ %><option value="<%=pr.entero("id")%>"><%=html(pr.texto("razon_social"))%></option><% } %></select></label><button class="btn btn-primary">Asociar</button></form><% for(Fila a:(List<Fila>)request.getAttribute("suministros")){ %><p><%=html(a.texto("producto"))%> → <%=html(a.texto("proveedor"))%></p><% } %></section><% } %>
<%@ include file="pie.jspf" %>
