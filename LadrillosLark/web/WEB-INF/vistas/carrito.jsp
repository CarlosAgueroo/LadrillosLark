<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<div class="section-title"><h1>Detalle de venta</h1><a href="<%=base%>/app/catalogo">Agregar productos →</a></div><section class="panel"><% List<LineaCarrito> lineas=(List<LineaCarrito>)request.getAttribute("lineas");BigDecimal subtotal=BigDecimal.ZERO;if(lineas.isEmpty()){ %><p>Detalle de venta está vacío. Agrega materiales desde el catálogo.</p><% }for(LineaCarrito l:lineas){subtotal=subtotal.add(l.subtotal()); %><div class="cart-row"><div><h3><%=html(l.nombre)%></h3><p>S/ <%=l.precio%> por unidad</p></div><form method="post" action="<%=base%>/app/carrito" class="inline"><input type="hidden" name="csrf" value="<%=csrf%>"><input type="hidden" name="producto" value="<%=l.producto%>"><label>Cantidad (0 para quitar)<input class="form-control" type="number" name="cantidad" min="0" max="1000000" value="<%=l.cantidad%>" required></label><button class="btn btn-outline-dark">Actualizar</button></form><strong>S/ <%=l.subtotal()%></strong></div><% } %><div class="summary"><p>Subtotal <strong>S/ <%=subtotal%></strong></p><p>Recojo: S/ 0.00 · Delivery: S/ 25.00</p><p>Total con delivery: S/ <%=subtotal.add(new BigDecimal("25.00"))%></p><% if(!lineas.isEmpty()){ %><a class="btn btn-primary" href="<%=base%>/app/checkout">Continuar venta →</a><% } %></div></section>
<%@ include file="pie.jspf" %>
