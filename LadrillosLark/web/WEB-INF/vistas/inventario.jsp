<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %>
<h1>Inventario</h1><section class="panel"><h2>Registrar movimiento</h2><p>Ajuste: escribe el stock final contado. Entrada, salida y reposición: escribe las unidades que se mueven.</p><form method="post" action="<%=base%>/app/movimiento" class="form-grid"><input type="hidden" name="csrf" value="<%=csrf%>"><label>Producto<select name="producto" class="form-select"><% for(Fila pr:(List<Fila>)request.getAttribute("productos")){ %><option value="<%=pr.entero("id")%>"><%=html(pr.texto("nombre"))%> · Stock <%=pr.entero("stock")%><%=pr.entero("stock")<=pr.entero("stock_minimo")?" · BAJO":""%></option><% } %></select></label><label>Tipo<select name="tipo" class="form-select"><option>ENTRADA</option><option>SALIDA</option><option>AJUSTE</option><option>REPOSICION</option></select></label><label>Cantidad / stock final<input type="number" name="cantidad" min="0" max="100000000" required class="form-control"></label><label>Proveedor (obligatorio en reposición)<select name="proveedor" class="form-select"><option value="">Sin proveedor</option><% for(Fila pr:(List<Fila>)request.getAttribute("proveedores")){ %><option value="<%=pr.entero("id")%>"><%=html(pr.texto("razon_social"))%></option><% } %></select></label><label>Motivo<input name="motivo" maxlength="250" required class="form-control"></label><button class="btn btn-primary">Registrar movimiento</button></form></section><section class="panel"><h2>Historial de movimientos</h2><%@ include file="tabla.jspf" %></section>
